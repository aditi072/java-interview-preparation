class Solution {
    public int removeElement(int[] nums, int val) {
        int i = 0; // Pointer for next non-val position
        
        for (int j = 0; j < nums.length; j++) {
            if (nums[j] != val) {
                nums[i] = nums[j]; // Place non-val element at position i
                i++;               // Move to next insertion position
            }
        }
        
        return i; // New length
    }
}
