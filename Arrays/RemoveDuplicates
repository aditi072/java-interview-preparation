class Solution {
    public int removeDuplicates(int[] nums) {
        int n = nums.length;
        int i=0, j=i+1;
        while(j<n){
            if(nums[j]!=nums[i]){
                nums[i+1] = nums[j];
                i++;
            }
            j++;
        }

        System.out.print(i+1);
        return i+1;
    }
}
