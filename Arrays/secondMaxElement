public class Array {
    public static void main(String[] args) {

        int n = 6;
        int[] arr = {1,4,2,6,8,9};
        int max = Integer.MIN_VALUE;
        int nextMax = Integer.MIN_VALUE;

        for(int i=0;i<n;i++){
            if(arr[i]>max){
                nextMax = max;
                max = arr[i];
            } else if(arr[i]>nextMax){
                nextMax = arr[i];
            }
        }
        System.out.println(nextMax);
    }
}
