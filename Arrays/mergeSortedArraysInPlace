import java.util.Arrays;

public class Array {
    public static void main(String[] args) {

        int[] arr1 = {10,20,35,0,0,0};
        int[] arr2 = {30,50,60};
        
        int[] result = merge(arr1, arr2);
        System.out.println(Arrays.toString(result));
    }

    public static int[] merge(int[] nums1, int[] nums2) {    
        int m = 3; int n = 3;
        int i=m-1, j=n-1;
        int idx = m+n-1;

        while(i>=0 && j>=0){
            if(nums1[i] >= nums2[j]){
               nums1[idx--] = nums1[i--]; 
            } else {
                nums1[idx--] = nums2[j--];
            }
        }
        // if elements are left in nums2 & nums1 is done 
        while(j >= 0){
            nums1[idx--] = nums2[j--];
        }
        return nums1;
    }

}
